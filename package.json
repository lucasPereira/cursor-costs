{
  "name": "cursor-usage",
  "version": "1.0.0",
  "description": "Download Cursor usage CSV and print spend summaries.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "headless": "HEADED=0 tsx src/index.ts",
    "headed": "HEADED=1 tsx src/index.ts",
    "monitor": "tsx src/monitor.ts",
    "experiment:start": "tsx src/experiments/gpt-5-dot-5-high-vs-composer-2/experimentCli.ts start",
    "experiment:finish": "tsx src/experiments/gpt-5-dot-5-high-vs-composer-2/experimentCli.ts finish",
    "experiment:select": "tsx src/experiments/gpt-5-dot-5-high-vs-composer-2/experimentCli.ts select",
    "experiment:download-csv": "tsx src/experiments/gpt-5-dot-5-high-vs-composer-2/experimentCli.ts download-csv",
    "experiment:analyze": "tsx src/experiments/gpt-5-dot-5-high-vs-composer-2/experimentCli.ts analyze",
    "experiment:bootstrap-submodules": "tsx src/experiments/gpt-5-dot-5-high-vs-composer-2/experimentCli.ts bootstrap-submodules"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "csv-parse": "^6.2.1",
    "dotenv": "^16.5.0",
    "node-notifier": "^10.0.1",
    "nodemailer": "^7.0.3",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
