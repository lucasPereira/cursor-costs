# HEADED — Playwright: use a visible browser if "1", "true", or "yes"; headless if "0", "false", or "no" (case insensitive).
HEADED=0

# COUNT_INCLUDED — required: "1", "true", or "yes" to count Included (plan) notional costs; "0", "false", or "no" to write those rows as Cost 0.00.
COUNT_INCLUDED=0

# MONITOR_INTERVAL_MINUTES — positive number: how many minutes to wait between checks.
MONITOR_INTERVAL_MINUTES=30

# SPEND_THRESHOLD_USD — positive number: alert when today’s cumulative spend in USD (local calendar day from midnight) exceeds this.
SPEND_THRESHOLD_USD=500

# Optional — Gmail: set all three to also send email when the threshold is crossed. Omit them to keep desktop notification only.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# NOTIFY_EMAIL_TO=you@gmail.com
